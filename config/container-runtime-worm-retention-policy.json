  "cosignLinuxAmd64Sha256": "f7622ed3cf22e55e1ae6377c080979ff77a22da9981c11df222a2e444991e7cf",
  "cloudflareBucketLockDocs": "https://developers.cloudflare.com/r2/buckets/bucket-locks/",
