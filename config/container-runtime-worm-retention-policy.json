{
  "schemaVersion": 2,
  "contract": "cinatoken-container-runtime-worm-retention-protocol-policy-v2",
  "repository": "cinagroup/cinatoken-rust",
  "environment": "staging",
  "provider": "cloudflare-r2",
  "prefixRoot": "container-runtime/s3/v1/",
  "minimumRetentionSeconds": 31536000,
  "lockRetentionSeconds": 34560000,
  "maximumClockSkewSeconds": 300,
  "maximumManifestLifetimeSeconds": 1800,
  "maximumEvidenceAgeSeconds": 3600,
  "maximumCredentialRemainingSeconds": 3600,
  "enforcementProbePolicy": {
    "publisherPreflight": {
      "httpStatus": 412,
      "errorCodes": [
        "PreconditionFailed"
      ]
    },
    "overwrite": {
      "httpStatus": 403,
      "errorCodes": [
        "AccessDenied"
      ]
    },
    "delete": {
      "httpStatus": 403,
      "errorCodes": [
        "AccessDenied"
      ]
    },
    "responseContentTypes": [
      "application/xml"
    ],
    "requestIdSources": [
      "cf-ray",
      "x-amz-request-id"
    ]
  },
  "requiredApprovalRoles": [
    "operations",
    "security"
  ],
  "requiredEvidenceKinds": [
    "authority-boundary",
    "lock-operator-revocation",
    "object-readback",
    "enforcement-probes",
    "publisher-revocation",
    "lock-readback"
  ],
  "requiredAuthorityRoles": [
    "publisher",
    "lock-operator",
    "object-verifier",
    "lock-verifier",
    "lifecycle-operator",
    "lifecycle-verifier"
  ],
  "requiredRevocationTargetRoles": [
    "lock-operator",
    "publisher"
  ],
  "requiredObjectKinds": [
    "source-evidence-packet",
    "provenance-evidence-packet",
    "provenance-statement",
    "sigstore-bundle",
    "provenance-report",
    "cosign-verification-log"
  ],
  "supportedJurisdictions": [
    "default",
    "eu",
    "fedramp"
  ],
  "sourceWorkflow": ".github/workflows/container-runtime-oci.yml",
  "provenanceWorkflow": ".github/workflows/container-runtime-provenance.yml",
  "provenanceCertificateIdentity": "https://github.com/cinagroup/cinatoken-rust/.github/workflows/container-runtime-provenance.yml@refs/heads/main",
  "provenanceOidcIssuer": "https://token.actions.githubusercontent.com",
  "provenanceBuilderId": "https://github.com/actions/runner/github-hosted",
  "cosignVersion": "v3.1.2",
  "cosignLinuxAmd64Sha256": "f7622ed3cf22e55e1ae6377c080979ff77a22da9981c11df222a2e444991e7cf",
  "cloudflareBucketLockDocs": "https://developers.cloudflare.com/r2/buckets/bucket-locks/",
  "cloudflareR2TokenDocs": "https://developers.cloudflare.com/r2/api/tokens/",
  "cloudflareS3ApiDocs": "https://developers.cloudflare.com/r2/api/s3/api/"
}
