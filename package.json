{
  "name": "cinatoken-rust",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "install:worker-build": "cargo install worker-build --locked",
    "inspect:source": "cargo run --quiet -p cinatoken-migration --bin cinatoken-migrate -- inspect-source",
    "export:sqlite": "cargo run --quiet -p cinatoken-migration --bin cinatoken-migrate -- export",
    "import:d1-sql": "cargo run --quiet -p cinatoken-migration --bin cinatoken-migrate -- import",
    "verify:migration": "cargo run --quiet -p cinatoken-migration --bin cinatoken-migrate -- verify",
    "dev:seed:sql": "cargo run --quiet -p cinatoken-migration --bin cinatoken-migrate -- dev-seed",
    "build:worker": "cd crates/worker && worker-build --release",
    "build:web": "bun tools/build_web.mjs",
    "check:web": "cd apps/web/source/default && bun run build:check",
    "check:web:quality": "cd apps/web/source/default && bun run lint && bun run format:check",
    "check:web:contract": "bun tools/verify_frontend_contract.mjs",
    "check:web:staging": "bun tools/verify_frontend_contract.mjs https://cinatoken-rust-api-staging.cinagroup.workers.dev",
    "audit:web:bundle": "bun tools/audit_frontend_bundle_redaction.mjs --summary",
    "check:web:bundle": "bun tools/audit_frontend_bundle_redaction.mjs --summary --fail-on-findings",
    "audit:web:bundle-budget": "bun tools/audit_frontend_bundle_budget.mjs --summary",
    "check:web:bundle-budget": "bun tools/audit_frontend_bundle_budget.mjs --summary --fail-on-budget",
    "audit:web:lint-debt": "bun tools/audit_frontend_lint_debt.mjs --summary",
    "check:web:lint-debt": "bun tools/audit_frontend_lint_debt.mjs --summary --fail-on-regression",
    "audit:web:routes": "bun tools/audit_frontend_routes.mjs",
    "check:web:routes": "bun tools/audit_frontend_routes.mjs --summary --fail-on-unclassified --check-baseline",
    "build:all": "bun run build:web && bun run build:worker",
    "check": "bun run check:web && bun run check:web:bundle && bun run check:web:bundle-budget && bun run check:web:lint-debt && bun run check:web:routes && cargo fmt --all --check && cargo test --workspace --exclude cinatoken-worker && cargo check -p cinatoken-worker --target wasm32-unknown-unknown",
    "check:worker": "cargo check -p cinatoken-worker --target wasm32-unknown-unknown",
    "check:cf:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run --minify",
    "check:cf:startup": "wrangler check startup --args=\"--dry-run --minify\"",
    "verify:sqlite": "python tools/verify_sqlite.py",
    "fmt": "cargo fmt --all"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
