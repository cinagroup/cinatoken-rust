/target/
/node_modules/
/services/*/node_modules/
/dist/
/build/
/crates/*/build/
/crates/*/.wrangler/
/services/*/.wrangler/
/.wrangler/
/.dev.vars
/services/container-controller/.dev.vars*
/services/container-controller/.env*
/services/drain-source-registration-permit-issuer/.dev.vars*
/services/drain-source-registration-permit-issuer/.env*
/services/drain-source-registration-coordinator/.dev.vars*
/services/drain-source-registration-coordinator/.env*
/exports/
*.cinatoken-export.json
*.log
__pycache__/
*.py[cod]

# Windows `nul` is a reserved device name; accidental `> nul` redirects in
# Git Bash create a stray file named `nul` that must never be committed.
/nul
