{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cinatoken-container-runtime-json-compatibility-executor-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "services": [
    {
      "binding": "CONTAINER_CONTROLLER_JSON_PROBE",
      "service": "cinatoken-container-controller-staging",
      "entrypoint": "JsonCompatibilityProbeEntrypoint"
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "JSON_COMPATIBILITY_EXECUTOR_ENABLED": "false"
  }
}
