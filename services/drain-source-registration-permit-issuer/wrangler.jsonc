{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cinatoken-drain-source-registration-permit-issuer-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "ENVIRONMENT": "local",
    "DRAIN_SOURCE_REGISTRATION_PERMIT_ISSUER_ENABLED": "false",
    "DRAIN_SOURCE_REGISTRATION_AUTHORITY_ISSUER": "cinatoken-relay-application-local",
    "DRAIN_SOURCE_REGISTRATION_AUTHORITY_AUDIENCE": "cinatoken-drain-source-registration-permit-issuer-local",
    "DRAIN_SOURCE_REGISTRATION_HMAC_CURRENT_KID": "",
    "DRAIN_SOURCE_REGISTRATION_HMAC_CURRENT_CREDENTIAL_ID_SHA256": "",
    "DRAIN_SOURCE_REGISTRATION_HMAC_PREVIOUS_KID": "",
    "DRAIN_SOURCE_REGISTRATION_HMAC_PREVIOUS_CREDENTIAL_ID_SHA256": "",
    "DRAIN_SOURCE_REGISTRATION_PERMIT_ISSUER": "cinatoken-drain-source-registration-permit-issuer-local",
    "DRAIN_SOURCE_REGISTRATION_PERMIT_AUDIENCE": "cinatoken-relay-application:local:drain-source-registration:v1",
    "DRAIN_SOURCE_REGISTRATION_PERMIT_KEY_ID": "",
    "DRAIN_SOURCE_REGISTRATION_PERMIT_SIGNER_IDENTITY_SHA256": "",
    "DRAIN_SOURCE_REGISTRATION_PERMIT_SPKI_SHA256": ""
  }
}
