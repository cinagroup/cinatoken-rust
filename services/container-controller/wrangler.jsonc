{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cinatoken-container-controller-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "ENVIRONMENT": "local",
    "CONTAINER_CONTROLLER_SERVICE_NAME": "cinatoken-container-controller-local",
    "CONTAINER_CONTROLLER_ENABLED": "false",
    "CONTAINER_EXECUTION_ENABLED": "false",
    "CONTAINER_READINESS_PROBE_ENABLED": "false",
    "CONTAINER_READINESS_WAKE_ENABLED": "false",
    "CONTAINER_STORAGE_R2_READ_ENABLED": "false",
    "CONTAINER_STORAGE_R2_WRITE_ENABLED": "false",
    "CONTAINER_STORAGE_KV_READ_ENABLED": "false",
    "CONTAINER_STORAGE_D1_READ_ENABLED": "false",
    "CONTAINER_PROVIDER_ATTEMPT_JOURNAL_ENABLED": "false",
    "CONTAINER_PROVIDER_CLIENT_ENABLED": "false",
    "CONTAINER_PROVIDER_EGRESS_ENABLED": "false",
    "CONTAINER_PROVIDER_RESPONSE_V3_PARSE_ENABLED": "false",
    "CONTAINER_PROVIDER_RESPONSE_RAW_WRITE_ENABLED": "false",
    "CONTAINER_PROVIDER_RESPONSE_CLIENT_WRITE_ENABLED": "false",
    "CONTAINER_PROVIDER_RESPONSE_TERMINAL_ENABLED": "false",
    "CONTAINER_PROVIDER_RETRY_ENABLED": "false",
    "CONTAINER_PROVIDER_ATTEMPT_STAGING_VERIFIED": "false",
    "CONTAINER_GLOBAL_TERMINAL_ACK_ENABLED": "false",
    "CONTAINER_GLOBAL_TERMINAL_COMPACTION_ENABLED": "false",
    "CONTAINER_OPERATION_RECOVERY_INTENT_V1_ENABLED": "false",
    "CONTAINER_OPERATION_RECOVERY_INTENT_V1_STAGING_VERIFIED": "false",
    "CONTAINER_DURABLE_OBJECT_JURISDICTION": "default",
    "CONTAINER_DURABLE_OBJECT_JURISDICTION_ENABLED": "false",
    "CONTAINER_DURABLE_OBJECT_JURISDICTION_STAGING_VERIFIED": "false",
    "CONTAINER_SHARD_PLACEMENT_ATTESTATION_WRITE_ENABLED": "false",
    "CONTAINER_SHARD_PLACEMENT_ATTESTATION_STAGING_VERIFIED": "false",
    "CONTAINER_SHARD_ACTIVATION_WRITE_ENABLED": "false",
    "CONTAINER_SHARD_ACTIVATION_EXPECTED_RUNTIME_BUILD_ID": "",
    "CONTAINER_MAX_PROVIDER_ATTEMPTS": "1",
    "CONTAINER_PROTOCOL_VERSION": "1",
    "CONTAINER_RING_GENERATION": "1",
    "CONTAINER_SHARD_COUNT": "8",
    "CONTAINER_PREVIOUS_RING_GENERATION": "0",
    "CONTAINER_PREVIOUS_SHARD_COUNT": "0",
    "CONTAINER_PREVIOUS_RING_ADMISSION_STARTED_AT": "0",
    "CONTAINER_PREVIOUS_RING_ADMISSION_UNTIL": "0",
    "CONTAINER_MAX_IN_FLIGHT_PER_SHARD": "2",
    "CONTAINER_TERMINAL_RETENTION_SECONDS": "604800",
    "CONTAINER_MAX_TERMINAL_OPERATIONS": "10000",
    "CONTAINER_AUTHORITY_ISSUER": "cinatoken-edge-local",
    "CONTAINER_AUTHORITY_AUDIENCE": "cinatoken-container-controller-local",
    "CONTAINER_AUTHORITY_CURRENT_KID": "local-v1",
    "CONTAINER_AUTHORITY_PREVIOUS_KID": "",
    "SHARD_PLACEMENT_READINESS_AUTHORITY_ISSUER": "cinatoken-shard-placement-authority-local",
    "SHARD_PLACEMENT_READINESS_AUTHORITY_AUDIENCE": "cinatoken-container-controller-local",
    "SHARD_PLACEMENT_READINESS_PROBE_CURRENT_KID": "local-probe-v1",
    "SHARD_PLACEMENT_READINESS_PROBE_PREVIOUS_KID": "",
    "SHARD_PLACEMENT_READINESS_READBACK_CURRENT_KID": "local-readback-v1",
    "SHARD_PLACEMENT_READINESS_READBACK_PREVIOUS_KID": "",
    "CONTROLLER_DISABLE_ATTESTATION_AUTHORITY_ISSUER": "cinatoken-shard-placement-authority-local",
    "CONTROLLER_DISABLE_ATTESTATION_AUTHORITY_AUDIENCE": "cinatoken-container-controller-local",
    "CONTROLLER_DISABLE_ATTESTATION_CURRENT_KID": "local-disable-attestation-v1",
    "CONTROLLER_DISABLE_ATTESTATION_PREVIOUS_KID": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cinatoken-rust-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILE_BUCKET",
      "bucket_name": "cinatoken-rust-files"
    }
  ],
  "services": [
    {
      "binding": "PROVIDER_EGRESS",
      "service": "cinatoken-container-egress-local"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_SHARDS",
        "class_name": "RelayShardContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-relay-shard-container",
      "new_sqlite_classes": ["RelayShardContainer"]
    }
  ],
  "containers": [
    {
      "class_name": "RelayShardContainer",
      "image": "../../crates/container-runtime/Dockerfile",
      "image_build_context": "../..",
      "max_instances": 8,
      "instance_type": "lite",
      "rollout_step_percentage": [10, 100],
      "rollout_active_grace_period": 300,
      "ssh": {
        "enabled": false
      }
    }
  ]
}
